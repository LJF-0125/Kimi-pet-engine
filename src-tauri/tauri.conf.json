{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kimi-pet",
  "version": "0.1.6",
  "identifier": "dev.xiaoxi.kimipet",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "width": 220,
        "height": 220,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNjRDQzVBNzRBQzc5NkEKUldScWVheDBXc3hrRStCVk9PdW9XaGpuc2lGTEFxZm5oeXRNdHFFeFp5ZW02UkVHbUxDSmx1MWQK",
      "endpoints": [
        "https://github.com/LJF-0125/Kimi-pet-engine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
